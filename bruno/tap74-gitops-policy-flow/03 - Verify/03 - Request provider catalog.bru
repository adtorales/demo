meta {
  name: 03 - Request provider catalog
  type: http
  seq: 3
}

post {
  url: {{consumerBaseUrl}}/catalog/request
  body: json
  auth: apikey
}

auth:apikey {
  key: X-Api-Key
  value: {{consumerApiKey}}
  placement: header
}

body:json {
  {
    "@context": [{ "@vocab": "https://w3id.org/edc/v0.0.1/ns/" }],
    "@type": "CatalogRequest",
    "counterPartyAddress": "{{providerDspUrl}}",
    "counterPartyId": "{{providerBpn}}",
    "protocol": "{{protocol}}",
    "querySpec": { "offset": 0, "limit": 50, "sortOrder": "DESC", "sortField": "fieldName", "filterExpression": [] }
  }
}
