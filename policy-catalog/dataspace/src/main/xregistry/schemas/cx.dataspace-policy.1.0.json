  "format": "JsonSchema/2020-12",
  "schema": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"urn:tap74:schema:cx:dataspace-policy:1.0\",\n  \"title\": \"Dataspace ODRL policy requirements\",\n  \"type\": \"object\",\n  \"required\": [\"@id\", \"@type\", \"permission\"],\n  \"properties\": {\n    \"@id\": {\"type\": \"string\", \"minLength\": 1},\n    \"@type\": {\"const\": \"odrl:Set\"},\n    \"permission\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"action\", \"constraint\"],\n        \"properties\": {\n          \"action\": {\"const\": \"use\"},\n          \"constraint\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"contains\": {\n              \"type\": \"object\",\n              \"required\": [\"leftOperand\", \"operator\", \"rightOperand\"],\n              \"properties\": {\n                \"leftOperand\": {\"type\": \"string\"},\n                \"operator\": {\"const\": \"eq\"},\n                \"rightOperand\": {\"type\": \"string\"}\n              }\n            }\n          }\n        }\n      },\n      \"contains\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"constraint\": {\n            \"contains\": {\n              \"type\": \"object\",\n              \"required\": [\"leftOperand\", \"operator\", \"rightOperand\"],\n              \"properties\": {\n                \"leftOperand\": {\"const\": \"FrameworkAgreement\"},\n                \"operator\": {\"const\": \"eq\"},\n                \"rightOperand\": {\"const\": \"CX-2026\"}\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"
